# --- Core ---
DATABASE_URL=postgres://viral:viral@localhost:5432/viral_invoice
APP_URL=http://localhost:3000

# --- Auth (better-auth) ---
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-32-bytes

# --- Encryption master key for tenant secrets (AES-256-GCM) ---
# Must be base64 of exactly 32 random bytes. Generate: openssl rand -base64 32
ENCRYPTION_KEY=replace-me-base64-32-bytes

# --- Email (Resend) ---
RESEND_API_KEY=re_xxx
EMAIL_FROM=Invoices <billing@example.com>

# --- Cron / delivery retry runner ---
# Generate: openssl rand -hex 24
CRON_SECRET=replace-me
